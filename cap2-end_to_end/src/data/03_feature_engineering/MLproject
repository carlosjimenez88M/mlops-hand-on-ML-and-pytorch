name: feature_engineering

entry_points:
  main:
    parameters:
      input_artifact_name:
        type: string
        description: "Name of the input artifact from W&B"

      gcs_input_path:
        type: string
        description: "GCS path to input data (without gs://bucket/)"

      gcs_output_path:
        type: string
        default: "data/03-features/housing_features.csv"
        description: "Path in GCS for feature-engineered data"

      artifact_name:
        type: string
        default: "housing_features"
        description: "Name of the output artifact in W&B"

      artifact_type:
        type: string
        default: "engineered_features"
        description: "Type of artifact"

      artifact_description:
        type: string
        default: ""
        description: "Artifact description"

      bucket_name:
        type: string
        description: "GCS bucket name"

      wandb_project:
        type: string
        default: "housing-mlops-gcp"
        description: "W&B Project"

      n_clusters:
        type: float
        default: 10
        description: "Number of clusters for geo features"

      gamma:
        type: float
        default: 0.1
        description: "Gamma parameter for clustering"

      random_state:
        type: float
        default: 42
        description: "Random state for reproducibility"

    command: |
      python main.py \
        --input_artifact_name {input_artifact_name} \
        --gcs_input_path {gcs_input_path} \
        --gcs_output_path {gcs_output_path} \
        --artifact_name {artifact_name} \
        --artifact_type {artifact_type} \
        --artifact_description {artifact_description} \
        --bucket_name {bucket_name} \
        --wandb_project {wandb_project} \
        --n_clusters {n_clusters} \
        --gamma {gamma} \
        --random_state {random_state}

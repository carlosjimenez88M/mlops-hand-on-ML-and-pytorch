name: data_segregation

entry_points:
  main:
    parameters:
      input_artifact_name:
        type: string
        description: "Name of the input artifact from W&B"

      gcs_input_path:
        type: string
        description: "GCS path to input data (without gs://bucket/)"

      gcs_train_output_path:
        type: string
        description: "GCS path for train data (without gs://bucket/)"

      gcs_test_output_path:
        type: string
        description: "GCS path for test data (without gs://bucket/)"

      artifact_root:
        type: string
        description: "Root name for output artifacts"

      artifact_type:
        type: string
        default: "segregated_data"
        description: "Type of artifact"

      artifact_description:
        type: string
        default: ""
        description: "Artifact description"

      bucket_name:
        type: string
        description: "GCS bucket name"

      wandb_project:
        type: string
        default: "housing-mlops-gcp"
        description: "W&B Project"

      test_size:
        type: float
        default: 0.2
        description: "Fraction of data for test set"

      random_state:
        type: int
        default: 42
        description: "Random state for reproducibility"

      target_column:
        type: string
        default: "median_house_value"
        description: "Target column name"

    command: |
      python main.py \
        --input_artifact_name {input_artifact_name} \
        --gcs_input_path {gcs_input_path} \
        --gcs_train_output_path {gcs_train_output_path} \
        --gcs_test_output_path {gcs_test_output_path} \
        --artifact_root {artifact_root} \
        --artifact_type {artifact_type} \
        --artifact_description {artifact_description} \
        --bucket_name {bucket_name} \
        --wandb_project {wandb_project} \
        --test_size {test_size} \
        --random_state {random_state} \
        --target_column {target_column}

# ============================================
# GCP Configuration
# ============================================

# GCS Bucket name (without gs://)
GCS_BUCKET_NAME=your-bucket-name

# GCP Project ID
GCP_PROJECT_ID=your-project-id

# GCP Region
GCP_REGION=us-central1

# Path to GCP service account credentials JSON file
# IMPORTANT: Never commit the actual credentials file to git!
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json


# ============================================
# Weights & Biases Configuration
# ============================================

# W&B Project name
WANDB_PROJECT=housing-mlops-gcp

# W&B Entity (team/username)
WANDB_ENTITY=your-wandb-username

# W&B API Key
# Get it from: https://wandb.ai/authorize
WANDB_API_KEY=your-wandb-api-key


# ============================================
# Local Paths (Optional)
# ============================================

# Local data directory for caching
LOCAL_DATA_DIR=./data


# ============================================
# Download Settings (Optional - have defaults)
# ============================================

# Download chunk size in bytes (default: 8192)
CHUNK_SIZE=8192

# Request timeout in seconds (default: 300)
TIMEOUT=300

# Maximum retry attempts (default: 3)
MAX_RETRIES=3

# =================================================================
# Environment Variables for Housing Price Prediction API
# Copy this file to .env and fill in your actual values
# =================================================================

# API Configuration
PORT=8080
PROJECT_NAME=Housing Price Prediction API
VERSION=1.0.0

# Model Loading Configuration
# Priority: MLflow > GCS > Local
# The API will try to load from MLflow first, then GCS, then local filesystem

# 1. Local Model Path (REQUIRED - fallback if MLflow/GCS unavailable)
LOCAL_MODEL_PATH=models/trained/housing_price_model.pkl

# 2. Google Cloud Storage (Optional)
GCS_BUCKET=
GCS_MODEL_PATH=models/trained/housing_price_model.pkl
GCP_PROJECT_ID=

# 3. MLflow Model Registry (Optional - recommended for production)
MLFLOW_MODEL_NAME=
MLFLOW_MODEL_STAGE=Production
MLFLOW_TRACKING_URI=

# Weights & Biases (for prediction logging and monitoring)
WANDB_API_KEY=your-wandb-api-key-here
WANDB_PROJECT=housing-mlops-api

# Google Cloud Authentication (if using GCS)
# Option 1: Service Account Key Path
GOOGLE_APPLICATION_CREDENTIALS=

# Option 2: Use gcloud auth (recommended for local development)
# Run: gcloud auth application-default login

# =================================================================
# Example Configurations
# =================================================================

# Development (Local model only):
# LOCAL_MODEL_PATH=models/trained/housing_price_model.pkl
# WANDB_API_KEY=your-key
# WANDB_PROJECT=housing-mlops-api

# Production (MLflow + W&B):
# LOCAL_MODEL_PATH=models/trained/housing_price_model.pkl
# MLFLOW_MODEL_NAME=housing_price_model
# MLFLOW_MODEL_STAGE=Production
# MLFLOW_TRACKING_URI=https://your-mlflow-server.com
# WANDB_API_KEY=your-key
# WANDB_PROJECT=housing-mlops-api-prod

# Cloud (GCS + W&B):
# LOCAL_MODEL_PATH=models/trained/housing_price_model.pkl
# GCS_BUCKET=your-bucket-name
# GCS_MODEL_PATH=models/trained/housing_price_model.pkl
# GCP_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# WANDB_API_KEY=your-key
# WANDB_PROJECT=housing-mlops-api-prod
